{
  "manifest_version": 3,
  "name": "BaratIn",
  "version": "1.0.0",
  "description": "Tout ça, c'est juste du pipeau.",
  "permissions": [],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://backend.baratin.workers.dev/*"
  ],
  "icons": {
    "48": "smug.png",
    "128": "smug.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "smug.png",
        "aulos.mp3",
        "flute1.webm",
        "flute2.webm",
        "flute3.webm",
        "flute4.webm"
      ],
      "matches": ["https://www.linkedin.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["src/content.ts"],
      "run_at": "document_idle"
    }
  ]
}